# 이 파일을 .env 로 복사하고 값을 채우세요.
# cp .env.example .env

# --- LLM 브레인: 자율 설계 에이전트 (기본 Gemini) ---
# Google AI Studio(aistudio.google.com/apikey)에서 발급, 무료 티어 있음.
# GOOGLE_API_KEY 로 넣어도 인식합니다. (로컬 deepB3P·ToxinPred3 엔진도 필요)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview   # 무료 티어 flash. pro는 쿼터 빡빡(429)
# (Anthropic Claude 브레인 구현은 `with-claude` 브랜치에 보존)

# --- (선택) 원격 deepB3P 예측 서버 — 로컬 엔진 대신 API로 대체할 때만 ---
# 둘 다 채워지면 로컬 미설치 시 원격 API 예측기를 사용합니다.
DEEPB3_API_URL=
DEEPB3_API_KEY=
